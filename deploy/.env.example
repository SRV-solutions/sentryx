# ====== /opt/sentryx/api/.env en el servidor (NO subir a git) ======
# setup-server.sh completa solo: DB_PASSWORD, JWT_SECRET y REALTIME_SECRET. El resto, a mano.
NODE_ENV=production
PORT=3000

# Base de datos local (PostgreSQL instalado en el mismo VPS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentryx
DB_USER=sentryx
DB_PASSWORD=
DB_SYNC=false

# Seguridad
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend en Netlify (agregar también el dominio propio si lo usan)
FRONTEND_URL=https://app.tudominio.com
CORS_ORIGINS=https://app.tudominio.com,https://tu-sitio.netlify.app

# Tiempo real (chat) en proceso aparte. Para moverlo a otro servidor: cambiar REALTIME_URL a ese host.
REALTIME_MODE=remote
REALTIME_URL=http://127.0.0.1:3001
REALTIME_PORT=3001
REALTIME_SECRET=

# Archivos y backups en Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sentryx-files
R2_BACKUP_BUCKET=sentryx-backups
# Capturas y videos de "Reportar un problema" (bucket aparte; sin él los reportes van solo con texto).
R2_REPORTS_BUCKET=sentryx-reports
BACKUP_KEEP=30
# El espacio de cada persona lo define su plan (5/15/30/50 GB). Tope opcional por colegio: School.storageQuotaMb.

# Push (generar en tu PC: cd api && npm run push:keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@wearesrv.com

# Email con Resend (dominio wearesrv.com verificado en resend.com/domains). Probar: npm run mail:test -- --to tu@email.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=info@wearesrv.com
MAIL_FROM_NAME=Sentryx · SRV

# Facturación: precio mensual por usuario activo (ARS) y huso horario del corte de mes
BILLING_PRICE_ARS=660
BILLING_TZ_OFFSET=-03:00

# --- Seguridad: solo el front puede usar la API ---
# Dónde escucha la API. En producción 127.0.0.1: solo se llega a través de Caddy (HTTPS).
HOST=127.0.0.1
# Claves para clientes que no son el navegador (app móvil, scripts de soporte), separadas por coma.
# Mínimo 24 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CLIENT_APP_KEYS=
