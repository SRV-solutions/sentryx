# Variables de la app (se incrustan al compilar; solo EXPO_PUBLIC_*). Copiá este archivo a .env.
# En desarrollo con Expo Go, el celular NO llega a "localhost": usá la IP de tu PC en la red wifi.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
EXPO_PUBLIC_REALTIME_URL=http://192.168.0.10:3000
EXPO_PUBLIC_WEB_URL=https://sentryx.wearesrv.com
# Clave de cliente registrada en la API (CLIENT_APP_KEYS del .env del backend, mínimo 24 caracteres).
EXPO_PUBLIC_CLIENT_KEY=
