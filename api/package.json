{
  "name": "sentryx-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:migrate:dev": "ts-node --transpile-only src/scripts/migrate.ts",
    "seed:demo": "ts-node --transpile-only src/scripts/seedDemo.ts",
    "seed:demo:prod": "node dist/scripts/seedDemo.js",
    "demo:content": "ts-node --transpile-only src/scripts/demoContent.ts",
    "demo:content:prod": "node dist/scripts/demoContent.js",
    "push:keys": "web-push generate-vapid-keys --json",
    "bootstrap": "node dist/scripts/bootstrap.js",
    "superadmin": "node dist/scripts/superadmin.js",
    "superadmin:dev": "ts-node --transpile-only src/scripts/superadmin.ts",
    "start:realtime": "node dist/realtime-server.js",
    "dev:realtime": "ts-node-dev --respawn --transpile-only src/realtime-server.ts",
    "db:backup": "node dist/scripts/backup.js",
    "audit:permissions": "ts-node --transpile-only src/scripts/auditPermissions.ts",
    "mail:test": "node dist/scripts/mailTest.js",
    "mail:test:dev": "ts-node --transpile-only src/scripts/mailTest.ts",
    "storage:setup": "node dist/scripts/storageSetup.js",
    "storage:setup:dev": "ts-node --transpile-only src/scripts/storageSetup.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API de Sentryx (SRV): plataforma escolar + cursos",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "@types/web-push": "^3.6.4",
    "sequelize-typescript": "^2.1.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
