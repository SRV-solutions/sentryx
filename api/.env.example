# --- General ---
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://sentryx.wearesrv.com
CORS_ORIGINS=https://sentryx.wearesrv.com

# --- Base de datos (DATABASE_URL o las variables sueltas) ---
# DATABASE_URL=postgres://user:pass@host:5432/sentryx
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentryx
DB_SSL=false
DB_POOL_MAX=10
# Solo desarrollo: crea tablas faltantes al arrancar. En producción usar `npm run db:migrate`.
DB_SYNC=false

# --- Seguridad (obligatorio en producción, mínimo 16 caracteres) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Email (vacío = Gmail con contraseña de aplicación; Brevo: smtp-relay.brevo.com; SES: email-smtp.<región>.amazonaws.com) ---
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Sentryx · SRV

# --- Archivos: Cloudflare R2 (descargas gratis, 10 GB sin cargo) ---
# Un solo bucket para todo (carpetas schools/, lessons/, reports/) y otro para backups.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sentryx-files
R2_BACKUP_BUCKET=sentryx-backups
STORAGE_QUOTA_MB=20480
FILE_MAX_MB=25
VIDEO_MAX_MB=300
# Solo si NO usás R2 (AWS S3 u otro compatible): AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# S3_ENDPOINT, S3_FILES_BUCKET, S3_VIDEO_BUCKET_NAME, S3_BUCKET_NAME

# --- Tiempo real (chat). embedded = dentro de la API (desarrollo); remote = proceso/servidor aparte (producción) ---
REALTIME_MODE=embedded
REALTIME_URL=http://127.0.0.1:3001
REALTIME_PORT=3001
REALTIME_SECRET=

# --- Notificaciones push (generar con: npm run push:keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@wearesrv.com

# --- IA (Solvix) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DB_AI_NAME=
EMBEDDING_SECRET=
