# --- General ---
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://sentryx.wearesrv.com
CORS_ORIGINS=https://sentryx.wearesrv.com

# --- Base de datos (DATABASE_URL o las variables sueltas) ---
# DATABASE_URL=postgres://user:pass@host:5432/sentryx
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentryx
DB_SSL=false
DB_POOL_MAX=10
# Solo desarrollo: crea tablas faltantes al arrancar. En producción usar `npm run db:migrate`.
DB_SYNC=false

# --- Seguridad (obligatorio en producción, mínimo 16 caracteres) ---
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Email (ver DEPLOY.md § 4). Probar con: npm run mail:test -- --to tu@email.com --check-dns ---
# Hostinger:  SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  SMTP_USER=sentryx@wearesrv.com  SMTP_PASS=<clave de la casilla>
# Resend:     SMTP_HOST=smtp.resend.com     SMTP_PORT=465  SMTP_USER=resend                SMTP_PASS=<API key>
# Amazon SES: SMTP_HOST=email-smtp.<región>.amazonaws.com  SMTP_PORT=587  SMTP_USER/PASS=<credenciales SMTP de SES>
# Vacío = Gmail con contraseña de aplicación (solo para desarrollo).
SMTP_HOST=smtp.hostinger.com 
SMTP_PORT=465
MAIL_FROM=info@wearesrv.com
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Sentryx · SRV

# --- Archivos: Cloudflare R2 (descargas gratis, 10 GB sin cargo) ---
# Un solo bucket para todo (carpetas schools/, lessons/, reports/) y otro para backups.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sentryx-files
R2_BACKUP_BUCKET=sentryx-backups
# Capturas y videos de "Reportar un problema" (bucket aparte; sin él los reportes van solo con texto).
R2_REPORTS_BUCKET=sentryx-reports
FILE_MAX_MB=1024
VIDEO_MAX_MB=1024
# Solo si NO usás R2 (AWS S3 u otro compatible): AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# S3_ENDPOINT, S3_FILES_BUCKET, S3_BUCKET_NAME

# --- Tiempo real (chat). embedded = dentro de la API (desarrollo); remote = proceso/servidor aparte (producción) ---
REALTIME_MODE=embedded
REALTIME_URL=http://127.0.0.1:3001
REALTIME_PORT=3001
REALTIME_SECRET=

# --- Notificaciones push (generar con: npm run push:keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@wearesrv.com


# Facturación: precio mensual por usuario activo (ARS) y huso horario del corte de mes
BILLING_PRICE_ARS=660
BILLING_TZ_OFFSET=-03:00

# --- Seguridad: solo el front puede usar la API ---
# Dónde escucha la API. En producción 127.0.0.1: solo se llega a través de Caddy (HTTPS).
HOST=0.0.0.0
# Claves para clientes que no son el navegador (app móvil, scripts de soporte), separadas por coma.
# Mínimo 24 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CLIENT_APP_KEYS=
