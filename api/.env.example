# --- General ---
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://sentryx.wearesrv.com
CORS_ORIGINS=https://sentryx.wearesrv.com

# --- Base de datos (DATABASE_URL o las variables sueltas) ---
# DATABASE_URL=postgres://user:pass@host:5432/sentryx
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentryx
DB_SSL=false
DB_POOL_MAX=10
# Solo desarrollo: crea tablas faltantes al arrancar. En producción usar `npm run db:migrate`.
DB_SYNC=false

# --- Seguridad (obligatorio en producción, mínimo 16 caracteres) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Email (Gmail con contraseña de aplicación; para volumen alto usar Amazon SES) ---
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Sentryx · SRV

# --- Archivos (S3) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_VIDEO_BUCKET_NAME=

# --- Notificaciones push (generar con: npm run push:keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@wearesrv.com

# --- IA (Solvix) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DB_AI_NAME=
EMBEDDING_SECRET=
